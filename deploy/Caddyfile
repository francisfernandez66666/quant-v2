# quant-trading-v2 HTTPS 反向代理 + 前端静态托管（Caddy）
# 部署：见 scripts/deploy_seoul.sh。Caddy 自动申请/续期 Let's Encrypt 证书，无需手动管证书。
#
# 使用前：
#   1. 把下面的域名替换成你的真实域名（DNS A 记录指向服务器 EIP）。
#
# 说明：
#   - 页面级 basic_auth 已移除：前端有自己的登录页，后端 /api/* 由 JWT 鉴权保护。
#   - 前端（web/dist）静态托管在 /var/www/quant-web，hash 路由无需 SPA fallback。
#   - /api 前缀（REST + SSE）单独 handle 反代到后端 127.0.0.1:8080，SSE 长连接天然透传。
#   - 两个 handle 分支按路径互斥：/api/* → 后端；其余（/、/assets/* 等）→ 静态前端。
#   - CORS 已由后端 corsMiddleware 全开（*），跨域 APK 走 /api 同样可用。

quant-trading.top {
	# 传输安全与压缩
	encode gzip

	# 后端 API / SSE（handle 精确匹配 /api 前缀，剥离后反代）
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	# 前端静态资源（其余所有路径）
	handle {
		root * /var/www/quant-web
		file_server
	}

	# 请求体上限（新闻原文/LLM 咨询可能较大）
	request_body {
		max_size 10MB
	}

	# 日志（可关）
	log {
		output file /var/log/caddy/quant.access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# 说明：如无需外部日志，可把整个 log 块删掉。
