# quant-carrier-hotreload.timer — owner 18:42 裁决：时效优先，交易日 08:45–15:30
# 每 5 分钟一烘（sha=白名单+利空归因+利好池，无变化幂等 NOTHING_TO_DO，不涨版本）。
[Unit]
Description=Quant carrier hot-reload schedule (Mon-Fri 08:45-15:30 every 5min)

[Timer]
OnCalendar=Mon..Fri *-*-* 08:45,50,55:00
OnCalendar=Mon..Fri *-*-* 09..14:0/5:00
OnCalendar=Mon..Fri *-*-* 15:00,05,10,15,20,25,30:00
Persistent=true
Unit=quant-carrier-hotreload.service

[Install]
WantedBy=timers.target
