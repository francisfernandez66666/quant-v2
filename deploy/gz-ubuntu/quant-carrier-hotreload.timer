# quant-carrier-hotreload.timer — owner 17:37 裁决：只在交易日 08:45–15:30 每半小时烘
# （夜间/周末不跑；白名单 sha 无变化时幂等 NOTHING_TO_DO，不涨版本不发布）。
# 08:45 首烘含盘前 LLM 归因合入。
[Unit]
Description=Quant carrier hot-reload schedule (Mon-Fri 08:45-15:30 every 30min)

[Timer]
OnCalendar=Mon..Fri *-*-* 08:45:00
OnCalendar=Mon..Fri *-*-* 09..14:00,30:00
OnCalendar=Mon..Fri *-*-* 15:00:00,15:30:00
Persistent=true
Unit=quant-carrier-hotreload.service

[Install]
WantedBy=timers.target
