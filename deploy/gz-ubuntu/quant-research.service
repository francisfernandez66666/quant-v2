# 广州 Ubuntu 外脑 quant-research unit（§6.6 工单 ③，2026-11-07）
# §RESOURCE-CAP-20261112（owner：恢复研究侧资源让路）：2 核机上 quant 主程序需要
# 5s 近实时打分，研究侧硬上限收到 60%（原 100% 等于允许吃满一整核）、内存软硬限
# 回到 500M/650M（现网旧值 700M/1100M 与 quant 的 900M 相加贴着物理内存）。
# 配额常驻、不按交易时段切换；时段退避由 scheduler.NightlyEligible 负责。
# 与仓库根 deploy/quant-research.service 同口径，发版时以本模板为准。
[Unit]
Description=quant-trading-v2 research scheduler (Guangzhou external brain)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quant
Group=quant
WorkingDirectory=/var/lib/quant-trading-v2
ExecStart=/opt/quant/researchd
Restart=always
RestartSec=5
LimitNOFILE=65535
EnvironmentFile=-/etc/quant.env

Nice=10
CPUWeight=8
CPUQuota=60%
MemoryHigh=500M
MemoryMax=650M
MemorySwapMax=512M
IOSchedulingClass=idle

Environment=TZ=Asia/Shanghai
Environment=QUANT_DATA_DIR=/var/lib/quant-trading-v2
Environment=PATH=/opt/quant:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=GOMAXPROCS=2

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quant-trading-v2
PrivateTmp=true

[Install]
WantedBy=multi-user.target
