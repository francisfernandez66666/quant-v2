# 广州 Ubuntu 外脑 quant 引擎 unit（§6.6 工单 ③，2026-11-07）
# 为什么不改 deploy/quant.service：那份是首尔 1.6G VPS 模板（8080 / 900M / GOMAXPROCS=4），
# 广州是 2 核 / 4GB，照抄会全站 502 且内存上限互相挤压（R7）。本文件只在广州外脑机使用。
# 端口以现网实测 8081 为准；pydata 的 8787/8788 冲突由现场裁一个（U-10）。
[Unit]
Description=quant-trading-v2 quant engine + API (Guangzhou external brain)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quant
Group=quant
WorkingDirectory=/opt/quant
ExecStart=/opt/quant/quant
Restart=always
RestartSec=5
LimitNOFILE=65535

# 2 核 / 4GB 重定：quant 常态 200-400M，软限先回收，硬限留足余量给 research + caddy + 系统。
# §MEM-20261119（现网事故）：软限 900M 低于 Go 堆的自然增长点 ⇒ 内核**持续回收**（swap 打满
# 1987/1987、load 3.1、/api/config/qmt 单请求 48.9s、健康检查 10s 超时），而进程不退出、
# systemd 的 Restart=always 也就不会拉起 —— 表现是"网页离线但服务 active"。
# 两处并改：①软限抬到 1200M（不再贴着 Go 堆）；②给 Go 一个明确上限 GOMEMLIMIT=768MiB，
# 让 GC 自己收（而不是靠内核 page reclaim 把堆换出去）。硬限仍 1400M（超了才 OOM，
# 那时是真见顶，宁可重启也不要 48s 的假活）。
MemoryHigh=1200M
MemoryMax=1400M
CPUQuota=150%
Environment=GOMAXPROCS=2
Environment=GOMEMLIMIT=768MiB

Environment=TZ=Asia/Shanghai
Environment=QUANT_ADDR=127.0.0.1:8081
Environment=QUANT_DATA_DIR=/var/lib/quant-trading-v2
# 密钥只进 0600 的 /etc/quant.env，不写进 unit；缺失不报错由代码按缺省处理。
EnvironmentFile=-/etc/quant.env

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quant-trading-v2
PrivateTmp=true

[Install]
WantedBy=multi-user.target
