<?xml version="1.0" encoding="UTF-8"?>
<!-- com.quant.backup.plist — Mac 每日备份拉取任务（HARDENING 件1 的 Mac 半边）
     语义：每日 07:00 与 10:30 各跑一次 restic_pull_backup.sh（两个时点的原因见下面
     StartCalendarInterval 的注释）；机器休眠错过则唤醒后立即补跑（launchd CalendarInterval 特性）。
     安装/升级一律走 ./install_mac_backup_agent.sh -Apply（拷脚本到稳定目录+装 plist+重载，-Kick 补跑一次）。
     ⚠️ 2026-09-25 实录教训：ProgramArguments 曾直指 Desktop 仓库路径——桌面是 macOS TCC 保护目录，
     launchd 拉起的 /bin/bash 读不到它：每天 07:00 定时触发、每天 `Operation not permitted`(126) 静默失败，
     异地副本停在 09-15 十天才被发现（告警代码在脚本体内，脚本没跑＝一声不吭）。
     脚本稳定副本必须放非保护目录 ~/backups/quant/bin/，仓库版只是源。
     查看：launchctl list | grep com.quant.backup；日志见 ~/backups/quant/pull_backup.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.quant.backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/zhangzifei/backups/quant/bin/restic_pull_backup.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<!-- §0929DRILL-B（2026-09-29）：由「每日 07:00 一次」改成「07:00 + 10:30 两次」。
	     为什么：广州侧 04:00 起跑的夜间快照**收工时间在 05:20~08:19 之间浮动**（6GB 级 trading.db
	     的 sqlite backup + restic backup/forget 耗时随仓增长），而拉取腿定在 07:00——
	     赶在收工之前那次就只拉到前一天的快照，异地侧系统性晚一天。
	     现网实录：09-29 07:00 读到的是 ts=2026-09-28T05:20:16（age=25h，离 26h 判红线只剩 1h），
	     而当日份在 08:19:38 才落盘。慢速公网的 sftp 熔断同样需要第二个窗口补跑。
	     两次都跑同一条幂等命令（copy 只拉缺的 pack，no-op 时几秒返回），不是"换个时间再装一遍"。
	     10:30 的选取刻意避开周日 09:00 的恢复演练（com.quant.drill，封顶 40 分钟 ⇒ 最晚 09:40）：
	     两边都要动 Mac 本地 restic 仓库的锁，撞上就是 copy 连败 8 次的假红。 -->
	<array>
		<dict>
			<key>Hour</key>
			<integer>7</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>10</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
	</array>
	<key>StandardOutPath</key>
	<string>/Users/zhangzifei/backups/quant/launchd.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/zhangzifei/backups/quant/launchd.err</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>HOME</key>
		<string>/Users/zhangzifei</string>
	</dict>
</dict>
</plist>
