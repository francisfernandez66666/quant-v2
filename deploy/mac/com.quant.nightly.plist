<?xml version="1.0" encoding="UTF-8"?>
<!-- com.quant.nightly.plist — Mac 每日「广州夜间研究验收」定时任务（§0929NIGHTLY，2026-09-29 新增调度）。
     语义：每天 09:20 跑 run_nightly_verify.sh（它再调 scripts/verify_nightly_guangzhou.sh 的七腿：
       服务态 / researchd 心跳 / 进程内存 / 成交额量纲抽检 / 任务队列积压 / 候选产出 / 财报覆盖，
       全部只读零写入），每次结果追加一行 JSON 到 ~/backups/quant/nightly_record.jsonl（失败也写）。
     为什么排 09:20：
       ① 夜间研究在广州 04:00~08:19 之间跑完快照与研究任务，09:20 能看到当日完整产出；
       ② 与 com.quant.backup 的 07:00 / 10:30 两个时点错开（它周日 07:00 还做 restic check）；
       ③ 与 com.quant.drill 的周日 09:00（封顶 40 分钟）不抢资源——验收腿不碰本地 restic 仓库。
     安装/升级一律走 ./install_mac_nightly_agent.sh -Apply（拷稳定副本 + 装 plist + 重载；
       -Kick 立即补跑一次验证通道活）。
     ⚠️ 与 com.quant.backup / com.quant.drill 同一条 TCC 教训：ProgramArguments 绝不指 Desktop
       仓库路径（桌面是 macOS 保护目录，launchd 拉起的 /bin/bash 读不到它，会"每天定时、
       每天静默失败(126)"）。稳定副本在 ~/backups/quant/nightly/，且保持 scripts/ 一层子目录，
       被调脚本将来若要按 ../.. 反推仓库根也不会指空。
     查看：launchctl list | grep com.quant.nightly；日志 ~/backups/quant/nightly_verify.log；
       新鲜度反查：tail -1 ~/backups/quant/nightly_record.jsonl（有记录才叫真跑过）。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.quant.nightly</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/zhangzifei/backups/quant/nightly/run_nightly_verify.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>20</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/zhangzifei/backups/quant/nightly_launchd.out</string>
	<key>StandardErrorPath</key>
	<string>/Users/zhangzifei/backups/quant/nightly_launchd.err</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>HOME</key>
		<string>/Users/zhangzifei</string>
	</dict>
</dict>
</plist>
