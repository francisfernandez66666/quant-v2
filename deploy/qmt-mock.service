# quant-trading-v2 MiniQMT mock 网关（AUTO_TRADING_PLAN M1/M2 联调）。
# 在首尔 Linux 服务器上先跑 mock 网关做端到端验证（建议→执行→回报→持仓刷新），
# 待 M2 真实 Windows 网关（qmt_gateway/）就绪后停用本服务。
# 敏感项从 /etc/qmt-mock.env 注入（QMT_MOCK_TOKEN / QMT_MOCK_SERVER / QMT_MOCK_DELAY 等）。
# 默认关闭（deploy 时 enabled=false），需联调时：sudo systemctl enable --now qmt-mock
# English: MiniQMT mock gateway service for pre-M2 end-to-end verification on the Seoul Linux box.
# Disabled by default; enable explicitly for integration runs.

[Unit]
Description=quant-trading-v2 MiniQMT mock gateway (M1/M2 联调)
Documentation=https://github.com/anomalyco/opencode
After=network-online.target quant.service
Wants=network-online.target

[Service]
Type=simple
User=quant
Group=quant
WorkingDirectory=/opt/quant
Environment=TZ=Asia/Shanghai
Environment=QMT_MOCK_LISTEN=127.0.0.1:8789
Environment=QMT_MOCK_SERVER=http://127.0.0.1:8080
EnvironmentFile=-/etc/qmt-mock.env
# 成交回报推给首尔 quant 的 /api/qmt/report（Bearer 鉴权用 QMT_MOCK_TOKEN）
ExecStart=/opt/quant/qmt-mock -listen ${QMT_MOCK_LISTEN} -token ${QMT_MOCK_TOKEN} -server ${QMT_MOCK_SERVER} -report-token ${QMT_MOCK_REPORT_TOKEN} -delay ${QMT_MOCK_DELAY}
Restart=always
RestartSec=5
MemoryMax=256M
LimitNOFILE=65535

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target