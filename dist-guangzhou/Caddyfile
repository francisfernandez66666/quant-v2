# 【已退役模板，勿套用】（2026-11-14 F3 标注）：本模板连 /livez 都没有反代——健康探针会落 SPA 兜底成 200 HTML（判据永远绿的假探针）。现役模板是 deploy/gz-ubuntu/Caddyfile（含 /livez + /readyz 反代）。
{
	auto_https off
}

:8080 {
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		root * C:\opt\quant\web
		file_server
		@html path /
		header @html Cache-Control "no-store"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}
}
