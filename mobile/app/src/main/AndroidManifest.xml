<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 访问云服务器 API / SSE 所需 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ 通知（WebView 内 Notification API 依赖此权限） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 极光推送 JPush 必需权限 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 极光自定义权限（SDK 内部广播使用，signature 级） -->
    <permission
        android:name="${applicationId}.permission.JPUSH_MESSAGE"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.JPUSH_MESSAGE" />

    <application
        android:name=".QuantApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Quant"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 极光推送：接收通知/自定义消息及 tag/alias 操作结果回调（继承 JPushMessageReceiver） -->
        <receiver
            android:name=".JPushMessageReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="cn.jpush.android.intent.RECEIVER_MESSAGE" />
                <category android:name="${applicationId}" />
            </intent-filter>
        </receiver>

        <!-- 极光 JCore 必需服务（JCore 4.9.4+/JPush 5.x 要求，缺失会导致初始化失败） -->
        <!-- English: JCommonService is required by JCore 5.x/JPush 5.x; without it JPush fails to init. -->
        <service
            android:name="cn.jpush.android.service.JCommonService"
            android:enabled="true"
            android:exported="false"
            android:process=":multiprocess">
            <intent-filter>
                <action android:name="cn.jpush.android.intent.PushService" />
            </intent-filter>
        </service>
    </application>
</manifest>