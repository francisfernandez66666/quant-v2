<?xml version="1.0" encoding="utf-8"?>
<!-- 网络安全配置：仅放行应用自己的云服务器域名（HTTPS 默认允许）。
     usesCleartextTraffic=true 是为兼容"先用 http://IP 验证"的阶段；
     生产走 https 域名时明文流量被系统拦截（Android 9+ 默认禁明文），此处无需额外白名单。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>